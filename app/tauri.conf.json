{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liblevo",
  "version": "0.1.0",
  "identifier": "com.jaimeacena.liblevo",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Liblevo",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  },
  "plugins": {}
}
